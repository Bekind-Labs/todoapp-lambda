{
  "name": "todoapp-backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "test": "vitest --run ./src",
    "e2etest": "vitest --run ./e2e",
    "lint:check": "biome check ./src/ ./e2e/",
    "lint": "biome check --write ./src/ ./e2e/",
    "build": "esbuild src/index.ts --bundle --minify --sourcemap --platform=node --target=es2020 --outfile=dist/index.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@types/aws-api-gateway-client": "^0.3.3",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^24.1.0",
    "esbuild": "^0.25.8",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "^3.876.0",
    "@aws-sdk/client-dynamodb": "^3.857.0",
    "@aws-sdk/lib-dynamodb": "^3.857.0"
  }
}
